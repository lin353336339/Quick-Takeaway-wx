<view class="container">
  <!-- 用户登录状态区域 -->
  <view class="login-status">
    <block wx:if="{{authentication && authentication !== 'null'}}">
      <!-- 已登录状态展示 -->
      <view class="user-info">
        <view class="welcome-text">欢迎使用快快达外卖</view>
        <view class="login-btn" bindtap="refreshAuthentication">刷新状态</view>
      </view>
    </block>
    <block wx:else>
      <!-- 未登录状态展示 -->
      <view class="user-info">
        <view class="welcome-text">欢迎使用快快达外卖，请登录</view>
        <view class="login-btn" bindtap="handleLogin">立即登录</view>
      </view>
    </block>
  </view>

  <!-- 商品信息模块整合 -->
  <view class="restaurant-info-section">
  
    <view class="shop-title-row">
      <view class="logo-container" style="background-color: #FFC200; border-radius: 8rpx; display: flex; align-items: center; justify-content: center;">
        <image class="shop-logo" src="../../static/icon.png" style="background-color: #FFC200;"></image>
      </view>
      <view class="shop-info">
        <view class="shop-name-row">
          <view class="shop-name">快快达外卖</view>
          <view class="shop-status">营业中</view>
        </view>
        <view class="address-row">
        <icon class="address-icon"></icon>
        <text class="address-text">北京市朝阳区新街大道一号楼8层</text>
      </view>
        <view class="shop-details">
          <view class="detail-item">
            <image class="detail-icon" src="../../static/length.png"></image>
            <text class="detail-text">距离1.5km</text>
          </view>
          <view class="detail-item">
            <image class="detail-icon" src="../../static/money.png"></image>
            <text class="detail-text">配送费6元</text>
          </view>
          <view class="detail-item">
            <image class="detail-icon" src="../../static/time.png"></image>
            <text class="detail-text">预计时长30min</text>
          </view>
        </view>
      </view>
    </view>
    <view class="store-data-content" wx:if="{{!loading}}">
    <view class="store-data-item">
      <view class="data-value">{{storeData.orderCount || 0}}</view>
      <view class="data-label">月售</view>
    </view>
    <view class="store-data-item">
      <view class="data-value">{{storeData.orderCompletionRate || 98}}%</view>
      <view class="data-label">订单完成率</view>
    </view>
    <view class="store-data-item">
      <view class="data-value">{{storeData.userOrderCount || 0}}</view>
      <view class="data-label">您的订单</view>
    </view>
  </view>
    <view class="restaurant-desc">
      <view class="desc-text">苍穹餐厅为顾客打造专业的大众化美食外送餐饮</view>

    </view>
    <view class="contact-phone" bindtap="handlePhone">
      <icon class="phone-icon"></icon>
    </view>
  </view>


  
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-text">加载中...</view>
  </view>
  
  <!-- 轮播图 -->
  <swiper class="banner-swiper" autoplay="{{true}}" interval="{{3000}}" duration="{{500}}" indicator-dots="{{false}}" circular="{{true}}">
    <swiper-item wx:for="{{promotionItems}}" wx:key="id">
      <view class="promotion-item">
        <view class="category-tag">
          <text>|</text>
          <text>{{item.title}}</text>
        </view>
        <view class="dish-info">
          <view class="dish-name">{{item.name || item.id}}</view>
          <view class="dish-price">¥{{item.price}}</view>
        </view>
        <view class="dish-image-container">
          <image class="dish-image" src="{{item.image}}" mode="aspectFill"></image>
        </view>
      </view>
    </swiper-item>
  </swiper>
  
  <!-- 销量Top10 -->
  <view class="top10-section">
    <view class="section-title">
      <view class="title-text">销量TOP10</view>
      <view class="more-btn" bindtap="goToCommodity">查看更多 ></view>
    </view>
    <scroll-view class="top10-scroll" scroll-x="true">
      <view class="top10-container">
        <view class="top10-card" wx:for="{{top10List}}" wx:key="{{index}}" bindtap="openDishDetail" data-dish="{{item}}">
          <image class="top10-image" src="{{item.image || '/static/imgDefault.png'}}" mode="aspectFill"></image>
          <view class="top10-info">
            <view class="top10-name">{{item.name}}</view>
            <view class="top10-price-sales">
              <text class="top10-price">¥{{item.amount}}</text>
              <text class="top10-sales">月销{{item.number}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
 