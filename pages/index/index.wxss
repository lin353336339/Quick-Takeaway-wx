.container {
  background-color: #f8f8f8;
  min-height: 100vh;
}

/* 登录状态区域样式 */
.login-status {
  background-color: white;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.welcome-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.login-btn {
  background-color: #ffc200;
  color: #333;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-weight: 500;
}

/* 整合商品模块的样式 */
.restaurant-info-section {
  background-color: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.shop-title-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.logo-container {
  width: 86rpx;
  height: 86rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.shop-logo {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  background-color: #FFC200;
}

.shop-info {
  flex: 1;
}

.shop-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.shop-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-right: 16rpx;
}

.shop-status {
  font-size: 24rpx;
  color: white;
  background-color: #4caf50;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.shop-details {
  display: flex;
  flex-wrap: wrap;
}

.detail-item {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
  margin-bottom: 8rpx;
}

.detail-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 6rpx;
}

.detail-text {
  font-size: 24rpx;
  color: #666;
}

.restaurant-desc {
  border-top: 1px dashed #ebebeb;
  padding-top: 16rpx;
  display: flex;
  flex-direction: column;
}

.desc-text {
  font-size: 24rpx;
  color: #9b9b9b;
  margin-bottom: 16rpx;
  line-height: 34rpx;
}

.address-row {
  display: flex;
  align-items: center;
}

.address-icon {
  display: inline-block;
  width: 20rpx;
  height: 34rpx;
  margin-right: 10rpx;
  background: url(data:image/png;base64,) no-repeat 0 0;
  background-size: contain;
}

.address-text {
  font-size: 24rpx;
  color: #9b9b9b;
  line-height: 34rpx;
}

.contact-phone {
  position: absolute;
  right: 30rpx;
  bottom: 30rpx;
  padding: 10rpx 20rpx;
  border-left: 1px solid rgba(219, 219, 219, 0.45);
}

.phone-icon {
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  background: url(data:image/png;base64,) no-repeat 0 0;
  background-size: contain;
}

.store-data-content {
  display: flex;
  justify-content: space-between;
  background-color: white;
  padding: 6rpx 30rpx;
  margin-bottom: 10rpx;
  border-top: 1px solid #f0f0f0;
}

.store-data-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 33.33%;
}

.data-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 0;
  margin-right: 8rpx;
  line-height: 1;
}

.data-label {
  font-size: 20rpx;
  color: #666;
  line-height: 1;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 120rpx;
  margin-bottom: 20rpx;
  background-color: white;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.order-btn {
  background-color: #ffc200;
  color: #333;
  font-size: 32rpx;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 8rpx;
  margin: 0 30rpx 30rpx;
  font-weight: 500;
}

/* 轮播图样式 */
.banner-swiper {
  width: 100%;
  height: 480rpx;
  margin-bottom: 20rpx;
}

.promotion-item {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: white;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  border: 1rpx solid #eee;
}

.category-tag {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.category-tag text:first-child {
  color: #ffc200;
  font-weight: bold;
  margin-right: 8rpx;
  font-size: 36rpx;
}

.category-tag text:last-child {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.dish-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.dish-name {
  font-size: 26rpx;
  color: #666;
}

.dish-price {
  font-size: 26rpx;
  color: #ffc200;
  font-weight: bold;
}

.dish-image-container {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.dish-image {
  width: 100%;
  height: 380rpx;
  border-radius: 8rpx;
  object-fit: cover;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

/* 销量Top10样式 */
.top10-section {
  margin-top: 20rpx;
  background-color: white;
  padding: 20rpx 0;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  position: relative;
  padding-left: 20rpx;
}

.title-text::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 30rpx;
  background-color: #ffc200;
}

.more-btn {
  font-size: 26rpx;
  color: #999;
}

.top10-scroll {
  width: 100%;
  white-space: nowrap;
}

.top10-container {
  display: inline-block;
  padding: 0 20rpx;
}

.top10-card {
  display: inline-block;
  width: 240rpx;
  margin-right: 20rpx;
  background-color: white;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  vertical-align: top;
  position: relative;
  transition: all 0.2s ease;
}

.top10-card:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 5rpx rgba(0,0,0,0.1);
}

.top10-image {
  width: 100%;
  height: 180rpx;
  object-fit: cover;
}

.top10-info {
  padding: 16rpx;
}

.top10-name {
  font-size: 28rpx;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 10rpx;
}

.top10-price-sales {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.top10-price {
  font-size: 26rpx;
  color: #ffc200;
  font-weight: bold;
}

.top10-sales {
  font-size: 22rpx;
  color: #999;
}
 