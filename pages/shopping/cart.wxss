/* 购物车页面样式 */
.cart-container {
    display: flex;
    flex-direction: column;
    padding: 20rpx;
    background-color: #f5f5f5;
    min-height: 100vh;
  }
  
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20rpx;
    background-color: #fff;
    border-radius: 10rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  }
  
  .title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
  }
  
  .clear-btn {
    font-size: 24rpx;
    color: #999;
    padding: 6rpx 20rpx;
    border: 1rpx solid #eee;
    border-radius: 30rpx;
  }
  
  .cart-content {
    background-color: white;
    border-radius: 10rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
    margin-bottom: 120rpx;
  }
  
  .cart-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx;
    border-bottom: 1rpx solid #f5f5f5;
  }
  
  .item-info {
    display: flex;
    align-items: center;
    flex: 1;
    position: relative;
  }
  
  .item-image {
    width: 120rpx;
    height: 120rpx;
    border-radius: 8rpx;
    margin-right: 20rpx;
    background-color: #f0f0f0;
  }
  
  .item-details {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .item-name {
    font-size: 28rpx;
    color: #333;
    margin-bottom: 10rpx;
  }
  
  .item-flavor {
    font-size: 24rpx;
    color: #999;
    margin-bottom: 8rpx;
  }
  
  .item-price {
    font-size: 28rpx;
    color: #ff5339;
    font-weight: bold;
  }
  
  .delete-btn {
    margin-right: 15rpx;
    width: 40rpx;
    height: 40rpx;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    background-color: #f0f0f0;
  }
  
  .delete-icon {
    font-size: 30rpx;
    color: #999;
    font-weight: bold;
  }
  
  .item-controls {
    display: flex;
    align-items: center;
  }
  
  .btn-minus, .btn-plus {
    width: 50rpx;
    height: 50rpx;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 28rpx;
    border-radius: 50%;
  }
  
  .btn-minus {
    background-color: #f8f8f8;
    color: #666;
    border: 1rpx solid #ddd;
  }
  
  .btn-plus {
    background-color: #ffc200;
    color: white;
  }
  
  .item-quantity {
    width: 60rpx;
    text-align: center;
    font-size: 28rpx;
  }
  
  .cart-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx 20rpx;
    background-color: #fff;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  }
  
  .total-info {
    display: flex;
    align-items: center;
  }
  
  .total-label {
    font-size: 28rpx;
    color: #333;
    margin-right: 10rpx;
  }
  
  .total-price {
    font-size: 36rpx;
    color: #ff5339;
    font-weight: bold;
  }
  
  .checkout-btn {
    padding: 15rpx 50rpx;
    background-color: #ffc200;
    color: white;
    border-radius: 50rpx;
    font-size: 28rpx;
  }
  
  .empty-cart {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 100rpx 0;
  }
  
  .empty-icon {
    width: 200rpx;
    height: 200rpx;
    margin-bottom: 30rpx;
  }
  
  .empty-text {
    font-size: 28rpx;
    color: #999;
    margin-bottom: 50rpx;
  }
  
  .go-shopping-btn {
    padding: 15rpx 60rpx;
    background-color: #ffc200;
    color: white;
    border-radius: 50rpx;
    font-size: 28rpx;
  }
  
  .loading {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.7);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 999;
  }
  
  .loader {
    width: 60rpx;
    height: 60rpx;
    border: 5rpx solid #f3f3f3;
    border-top: 5rpx solid #ffc200;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }
  
  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }